#!/bin/sh
#
# @name Gazebo x500 mono cam
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_mono_cam}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# OpenVINS (ROS2 -> PX4) initial defaults for EV fusion.
# Keep minimal and tune in runtime if timestamp/frame offsets exist.
param set-default EKF2_EV_CTRL 11
param set-default EKF2_EV_DELAY 0
param set-default EKF2_HGT_REF 0
param set-default EKF2_EV_POS_X 0.0
param set-default EKF2_EV_POS_Y 0.0
param set-default EKF2_EV_POS_Z 0.0

# Keep the mono VINS SITL usable without QGroundControl attached.
param set-default NAV_DLL_ACT 0
